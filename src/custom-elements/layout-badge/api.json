{
  "$schema": "../../schemas/api.schema.json",
  "element": "layout-badge",
  "type": "custom-element",
  "description": "Small inline status or count badge. Surface elements use bare data-* attributes.",
  "htmlvalidate": {
    "flow": true,
    "phrasing": true,
    "permittedContent": [
      "@phrasing"
    ]
  },
  "attributes": [
    {
      "name": "data-size",
      "kind": "data",
      "purpose": "config",
      "type": "enum",
      "values": [
        "sm",
        "lg"
      ],
      "description": "Size: sm or lg (default medium)."
    },
    {
      "name": "data-color",
      "kind": "data",
      "purpose": "config",
      "type": "enum",
      "values": [
        "primary",
        "success",
        "warning",
        "error",
        "info",
        "brand",
        "secondary",
        "accent"
      ],
      "description": "Semantic or brand color."
    },
    {
      "name": "data-variant",
      "kind": "data",
      "purpose": "config",
      "type": "enum",
      "values": [
        "subtle",
        "outlined"
      ],
      "description": "subtle (tinted) or outlined instead of filled."
    },
    {
      "name": "data-shape",
      "kind": "data",
      "purpose": "config",
      "type": "enum",
      "values": [
        "square"
      ],
      "description": "square corners instead of a pill."
    }
  ]
}
