{
  "title": "Password reset",
  "steps": [
    { "type": "start", "text": "Click \"Forgot password\"" },
    { "type": "action", "text": "Enter email" },
    { "type": "process", "text": "Send reset link", "annotation": "Expires in 1 hour" },
    { "type": "wait", "text": "Wait for click" },
    {
      "type": "decision",
      "text": "Link still valid?",
      "branches": [
        { "label": "Yes", "steps": [{ "type": "action", "text": "Choose new password" }, { "type": "end", "text": "Signed in" }] },
        { "label": "No", "steps": [{ "type": "end", "text": "Request a new link" }] }
      ]
    }
  ]
}
